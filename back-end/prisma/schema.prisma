// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SourceType {
  BANK
  INTERNAL
}

enum UploadStatus {
  RECEIVED
  VALIDATING
  PARSING
  IMPORTING
  COMPLETED
  PARTIAL_SUCCESS
  AWAITING_CONFIRM
  FAILED
  CANCELLED
}

enum RunStatus {
  OPEN
  IN_REVIEW
  CLOSED
}

enum TriageBucket {
  PAY
  VERIFY
  BANK_ONLY
  INTERNAL_ONLY
}

/// Estados persistidos em `MatchSuggestion.status` (fonte de verdade para triagem e pagamento).
/// OPEN = pendente; APPROVED = conferido (liberado); REJECTED/IGNORED = fora do fluxo.
enum SuggestionStatus {
  OPEN
  APPROVED
  REJECTED
  IGNORED
}

/// Vínculo manual: sem par banco aprovado como PIX/TED, ou boleto só banco aprovado manualmente.
enum PaymentVinculoKind {
  PIX
  TED
  BOLETO
}

enum SuggestionReason {
  EXACT_NAME_VALUE
  FUZZY_NAME_MATCH
  VALUE_ONLY
  MULTIPLE_CANDIDATES
  AGGREGATED_CANDIDATE
  NO_INTERNAL_MATCH
  NO_BANK_MATCH
  /// Interno sem banco, mas o fornecedor já foi cadastrado como pagamento PIX (aguarda confirmação).
  PIX_CANDIDATE
  /// Interno sem banco, fornecedor já cadastrado como TED (aguarda confirmação).
  TED_CANDIDATE
  /// Item aprovado como pagamento via PIX (vínculo manual ou confirmação de PIX_CANDIDATE).
  PIX_VINCULO_OK
  /// Item aprovado como TED (vínculo manual ou confirmação de TED_CANDIDATE).
  TED_VINCULO_OK
  /// Boleto só banco (sem par interno): aprovado com conferência manual, opcional imagem.
  BOLETO_VINCULO_OK
  MANUAL_REVIEW_REQUIRED
}

enum ReconciliationType {
  EXACT
  MANUAL
  AGGREGATED
  VALUE_ONLY_CONFIRMED
}

enum PaymentStatus {
  NOT_PAID
  PAID
  PARTIALLY_PAID
  CANCELLED
}

enum UnitType {
  PEDERTRACTOR
  TRACTOR
}

enum UserRole {
  FINANCIAL
  ADMIN
}

/// Casamento linha do extrato diário × sugestão marcada como paga.
enum BankExtratoMatchKind {
  AUTO
  MANUAL
}

model User {
  id           String   @id @default(cuid())
  employeeId   String   @unique
  name         String
  unit         UnitType
  cardNumber   String
  passwordHash String
  role         UserRole
  active       Boolean  @default(true)
  firstLogin   Boolean  @default(true)

  createdRuns     ReconciliationRun[]   @relation("RunCreatedBy")
  uploadedFiles   FileUpload[]
  suggestions     MatchSuggestion[]     @relation("SuggestionReviewedBy")
  suggestionsPaid MatchSuggestion[]     @relation("SuggestionPaidBy")
  reconciliations ReconciliationGroup[] @relation("ReconciliationReviewedBy")
  payments        PaymentMark[]
  paymentVinculosCreated PaymentVinculoName[] @relation("PaymentVinculoCreatedBy")
  bankExtratoImports     BankExtratoImport[] @relation("BankExtratoImportedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cardNumber, unit])
}

model ReconciliationRun {
  id                 String    @id @default(cuid())
  /// Dados e sugestões desta execução pertencem a esta empresa.
  unit               UnitType
  title              String?
  referenceStartDate DateTime?
  referenceEndDate   DateTime?
  status             RunStatus @default(OPEN)
  notes              String?

  createdById String?
  createdBy   User?   @relation("RunCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  uploads         FileUpload[]
  bankRecords     BankRecord[]
  internalRecords InternalRecord[]
  suggestions     MatchSuggestion[]
  reconciliations ReconciliationGroup[]
  paymentMarks        PaymentMark[]
  bankExtratoImports  BankExtratoImport[]

  @@index([referenceStartDate, referenceEndDate])
  @@index([status])
  @@index([unit])
  @@index([createdById, unit])
}

model FileUpload {
  id           String  @id @default(cuid())
  runId        String?
  uploadedById String?

  sourceType SourceType
  status     UploadStatus @default(RECEIVED)

  originalFileName String
  storedFileName   String?
  storagePath      String?
  mimeType         String?
  fileExtension    String?
  fileSizeBytes    Int?

  fileHash           String?
  workbookSheetCount Int?
  selectedSheetName  String?

  startedAt         DateTime?
  parsingStartedAt  DateTime?
  parsingFinishedAt DateTime?
  importedAt        DateTime?
  finishedAt        DateTime?

  parseDurationMs  Int?
  importDurationMs Int?
  totalDurationMs  Int?

  totalRowsDetected     Int?
  totalRowsRead         Int?
  totalRowsImported     Int?
  totalRowsRejected     Int?
  totalRowsSkipped      Int?
  totalRowsUpdated      Int?
  totalRowsWithWarnings Int?

  headerRowIndex      Int?
  detectedColumnsJson Json?
  mappingColumnsJson  Json?

  parserVersion String?
  importVersion String?

  errorMessage       String?
  errorDetailsJson   Json?
  warningDetailsJson Json?

  run        ReconciliationRun? @relation(fields: [runId], references: [id], onDelete: SetNull)
  uploadedBy User?              @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  bankRecords     BankRecord[]
  internalRecords InternalRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([runId])
  @@index([uploadedById])
  @@index([sourceType, status])
  @@index([fileHash])
  @@index([createdAt])
}

model BankRecord {
  id           String  @id @default(cuid())
  runId        String
  fileUploadId String?

  rowNumber            Int?
  dueDate              DateTime?
  beneficiaryNameRaw   String
  beneficiaryNameNorm  String?
  beneficiaryNameCanon String?
  payerNameRaw         String?
  nossoNumero          String?
  amount               Decimal   @db.Decimal(14, 2)
  importIdentityKey    String?

  run        ReconciliationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  fileUpload FileUpload?       @relation(fields: [fileUploadId], references: [id], onDelete: SetNull)

  suggestionLinks     SuggestionBankLink[]
  reconciliationLinks ReconciliationBankLink[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([runId, importIdentityKey])
  @@index([runId, dueDate])
  @@index([amount])
  @@index([beneficiaryNameNorm])
  @@index([beneficiaryNameCanon])
  @@index([nossoNumero])
}

model InternalRecord {
  id           String  @id @default(cuid())
  runId        String
  fileUploadId String?

  rowNumber         Int?
  dueDate           DateTime?
  issueDate         DateTime?
  supplierCode      Int?
  supplierNameRaw   String
  supplierNameNorm  String?
  supplierNameCanon String?
  walletCode        String?
  branchCode        String?
  invoiceNumber     String?
  installment       String?
  amount            Decimal   @db.Decimal(14, 2)
  amountPaid        Decimal?  @db.Decimal(14, 2)
  dda               String?
  notes             String?
  importIdentityKey String?

  run        ReconciliationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  fileUpload FileUpload?       @relation(fields: [fileUploadId], references: [id], onDelete: SetNull)

  suggestionLinks     SuggestionInternalLink[]
  reconciliationLinks ReconciliationInternalLink[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([runId, importIdentityKey])
  @@index([runId, dueDate])
  @@index([amount])
  @@index([supplierNameNorm])
  @@index([supplierNameCanon])
  @@index([supplierCode])
  @@index([walletCode])
  @@index([invoiceNumber])
}

model MatchSuggestion {
  id    String @id @default(cuid())
  runId String

  triageBucket TriageBucket
  /// Estado da triagem / conferido para o financeiro (persistido; `APPROVED` = conferido).
  status          SuggestionStatus @default(OPEN)
  /// Momento em que a sugestão virou `APPROVED` (ex.: tecla A). Nulo se ainda pendente.
  confirmedAt     DateTime?
  reason            SuggestionReason

  scorePercent     Int
  amountScore      Int @default(0)
  nameScore        Int @default(0)
  dateScore        Int @default(0)
  ambiguityPenalty Int @default(0)

  amountDifference Decimal? @db.Decimal(14, 2)
  confidenceLabel  String?
  explanation        String?

  /// Usuário que conferiu (APPROVED) ou revisou.
  reviewedById String?
  reviewedBy   User?   @relation("SuggestionReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  /// Aprovado como "sem par banco" vinculado a PIX ou TED (exibe ícone na triagem).
  paymentVinculoKind PaymentVinculoKind?
  /// Comprovante (imagem) da conferência manual de boleto, caminho relativo a `UPLOAD_DIR`.
  manualBoletoEvidenceRelPath String?
  /// Financeiro marcou a conta como paga (independente de PIX/TED).
  paidAt   DateTime?
  paidById String?
  paidBy   User?   @relation("SuggestionPaidBy", fields: [paidById], references: [id], onDelete: SetNull)

  run ReconciliationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  bankLinks     SuggestionBankLink[]
  internalLinks SuggestionInternalLink[]

  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  reconciliationGroups   ReconciliationGroup[]
  extratoSuggestionMatches BankExtratoSuggestionMatch[]

  @@index([runId, triageBucket])
  @@index([runId, status])
  /// Cobre ordenação da lista (triage → status → score) no escopo do run.
  @@index([runId, triageBucket, status, scorePercent])
  /// Filtro “abertos só interno” (triagem) em `loadInternalOnlyPoolForSumHints`.
  @@index([runId, status, triageBucket])
  @@index([status])
  @@index([scorePercent])
  @@index([reason])
  @@index([runId, confirmedAt])
  @@index([paidAt])
  @@index([runId, paidAt])
}

model SuggestionBankLink {
  id           String @id @default(cuid())
  suggestionId String
  bankRecordId String

  suggestion MatchSuggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)
  bankRecord BankRecord      @relation(fields: [bankRecordId], references: [id], onDelete: Cascade)

  @@unique([suggestionId, bankRecordId])
  @@index([bankRecordId])
}

model SuggestionInternalLink {
  id               String @id @default(cuid())
  suggestionId     String
  internalRecordId String

  suggestion     MatchSuggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)
  internalRecord InternalRecord  @relation(fields: [internalRecordId], references: [id], onDelete: Cascade)

  @@unique([suggestionId, internalRecordId])
  @@index([internalRecordId])
}

model ReconciliationGroup {
  id                 String  @id @default(cuid())
  runId              String
  sourceSuggestionId String?

  reconciliationType ReconciliationType
  confirmedByUserId  String?
  confirmedByUser    User?              @relation("ReconciliationReviewedBy", fields: [confirmedByUserId], references: [id], onDelete: SetNull)

  finalScorePercent Int?
  notes             String?

  run              ReconciliationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  sourceSuggestion MatchSuggestion?  @relation(fields: [sourceSuggestionId], references: [id], onDelete: SetNull)

  bankLinks     ReconciliationBankLink[]
  internalLinks ReconciliationInternalLink[]
  paymentMarks  PaymentMark[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([runId])
  @@index([reconciliationType])
}

model ReconciliationBankLink {
  id               String @id @default(cuid())
  reconciliationId String
  bankRecordId     String

  reconciliation ReconciliationGroup @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)
  bankRecord     BankRecord          @relation(fields: [bankRecordId], references: [id], onDelete: Cascade)

  @@unique([reconciliationId, bankRecordId])
  @@index([bankRecordId])
}

model ReconciliationInternalLink {
  id               String @id @default(cuid())
  reconciliationId String
  internalRecordId String

  reconciliation ReconciliationGroup @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)
  internalRecord InternalRecord      @relation(fields: [internalRecordId], references: [id], onDelete: Cascade)

  @@unique([reconciliationId, internalRecordId])
  @@index([internalRecordId])
}

model PaymentMark {
  id               String  @id @default(cuid())
  runId            String
  reconciliationId String?

  status           PaymentStatus @default(NOT_PAID)
  paidAmount       Decimal?      @db.Decimal(14, 2)
  paidAt           DateTime?
  paymentReference String?
  receiptUrl       String?
  notes            String?

  markedById String?
  markedBy   User?   @relation(fields: [markedById], references: [id], onDelete: SetNull)

  run            ReconciliationRun    @relation(fields: [runId], references: [id], onDelete: Cascade)
  reconciliation ReconciliationGroup? @relation(fields: [reconciliationId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([runId, status])
  @@index([paidAt])
}

model CounterpartyAlias {
  id             String      @id @default(cuid())
  sourceType     SourceType?
  rawName        String
  normalizedName String?
  canonicalName  String
  active         Boolean     @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([normalizedName])
  @@index([canonicalName])
}

/// Nome (normalizado) cadastrado como pago via PIX ou TED em “sem par banco”.
model PaymentVinculoName {
  id             String             @id @default(cuid())
  kind           PaymentVinculoKind @default(PIX)
  normalizedName String
  displayName    String
  /// Nome/razão social usado no comprovante (editável; default vindo do ERP).
  registroNome   String?
  /// Código identificador interno inserido pelo usuário.
  userCode       String?
  /// Chave PIX (e-mail, telefone, CPF, CNPJ, aleatória, etc.).
  pixChave       String?
  tedBanco       String?
  tedAgencia     String?
  tedConta       String?
  tedCnpj        String?
  createdById    String?
  createdBy      User?              @relation("PaymentVinculoCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([normalizedName, kind])
  @@map("PixVinculoName")
}

/// Importação de extrato diário exportado pelo banco (conferência vs contas marcadas pagas).
model BankExtratoImport {
  id               String @id @default(cuid())
  runId            String
  uploadedById     String?
  originalFileName String
  storagePath      String?
  /// Dia de referência: substitui import anterior do mesmo run nesta data.
  referenceDate    DateTime @db.Date
  /// Janela de vencimento usada no casamento (mesma da listagem na importação); `yyyy-MM-dd`.
  compareFromYmd   String?
  compareToYmd     String?

  run        ReconciliationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  uploadedBy User?              @relation("BankExtratoImportedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  lines      BankExtratoLine[]
  matches    BankExtratoSuggestionMatch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([runId, referenceDate])
  @@index([runId])
  @@index([uploadedById])
}

model BankExtratoLine {
  id                    String @id @default(cuid())
  extratoImportId       String
  rowNumber             Int
  paymentDate           DateTime?
  beneficiaryRaw        String
  beneficiaryNorm       String?
  documentNumberRaw     String?
  paymentNumberRaw      String?
  clientNumberRaw       String?
  amount                Decimal   @db.Decimal(14, 2)
  paymentTypeRaw        String?
  statusRaw             String?
  channelRaw            String?

  extratoImport BankExtratoImport @relation(fields: [extratoImportId], references: [id], onDelete: Cascade)
  match         BankExtratoSuggestionMatch?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([extratoImportId])
  @@index([amount])
  @@index([beneficiaryNorm])
}

/// Casamento persisted; vínculo 1–1 linha × sugestão paga dentro do mesmo import.
model BankExtratoSuggestionMatch {
  id               String               @id @default(cuid())
  extratoImportId  String
  extratoLineId    String               @unique
  suggestionId     String
  matchKind        BankExtratoMatchKind
  justification    String?
  createdById      String?

  extratoImport BankExtratoImport  @relation(fields: [extratoImportId], references: [id], onDelete: Cascade)
  extratoLine   BankExtratoLine    @relation(fields: [extratoLineId], references: [id], onDelete: Cascade)
  suggestion    MatchSuggestion    @relation(fields: [suggestionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([extratoImportId, suggestionId])
  @@index([extratoImportId])
  @@index([suggestionId])
}
